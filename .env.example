# Copy this file to `.env.local` and fill in your own values.
# (On Windows: copy .env.example .env.local)
#
# Find all three values in your Supabase dashboard under Project Settings → API.

# Project URL — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public "anon" key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret "service_role" key — server-side only.
# NEVER expose this in the browser and NEVER commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
